# Host ports
WEB_PORT=3000
API_PORT=8080
DB_PORT=5432

# PostgreSQL credentials (change these outside local development)
DB_USER=blogs
DB_PASSWORD=blogs
DB_NAME=blogs

# Local image storage, relative to the repository root when running locally
UPLOAD_DIR=uploads

# Single-owner authentication (required)
# Quick setup: set your own password (1-72 bytes), then restart the backend.
# Single quotes preserve literal $ and # in Docker Compose. Never commit .env.
AUTH_PASSWORD=
# Optional alternative: go run ./cmd/hashpass
# A non-empty AUTH_PASSWORD_HASH takes precedence over AUTH_PASSWORD.
AUTH_PASSWORD_HASH=
# Generate a secret of at least 32 bytes, for example: openssl rand -hex 32
AUTH_JWT_SECRET=
# Local HTTP must opt out explicitly. Production HTTPS must set this to true.
AUTH_COOKIE_SECURE=false
# Comma-separated exact origins; do not use * or include URL paths.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
